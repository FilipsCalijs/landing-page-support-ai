# Public site URL - used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://removedorderoupa.com

# Brand name rendered in the navbar, footer and metadata. The suffix is the part
# printed in the accent colour right after it - together they read as the domain.
NEXT_PUBLIC_SITE_NAME=removedorderoupa
NEXT_PUBLIC_SITE_NAME_SUFFIX=.com

# Default locale served when no locale is negotiated
NEXT_PUBLIC_DEFAULT_LOCALE=en
