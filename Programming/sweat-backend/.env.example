# Copy to .env and adjust.
ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://sweat:sweat@localhost:5433/sweat
REDIS_URL=redis://localhost:6380/0

# Initial admin (created by scripts/seed.py)
ADMIN_SEED_EMAIL=admin@sweatcompanion.com
ADMIN_SEED_PASSWORD=change-me-strong-password

# Cookies are marked Secure only in prod (HTTPS behind Cloudflare)
COOKIE_SECURE=false
MAIN_HOST=sweatcompanion.com

# Shared secret for the private app API (/api/app/v1/*). The Next.js server (BFF)
# sends it as the X-Internal-Secret header; must match the frontend's copy. The
# browser never calls this backend directly — end-user auth stays in the frontend.
INTERNAL_API_SECRET=change-me-shared-with-frontend

# Timestamps are stored/generated in UTC — this only controls how the admin UI displays them.
DISPLAY_TIMEZONE=Europe/Riga

# --- Weights (LoRA/checkpoint) storage: "local" (dev stub, default) or "s3" ---
WEIGHTS_STORAGE=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Generated media storage: same local/s3 split as weights ---
MEDIA_STORAGE=local

# --- Generation backend: "stub" (default, draws placeholder images) or "runpod" ---
GENERATION_PROVIDER=stub

# RunPod Serverless endpoint (Settings -> API Keys on your RunPod dashboard)
# Each ComfyUI graph variant runs on its own endpoint/Docker image: RUNPOD_ENDPOINT_ID
# handles the "main_sdxl" workflow_template, RUNPOD_ENDPOINT_ID_ILLUSTRATION handles the
# "illustration" workflow_template, RUNPOD_ENDPOINT_ID_VIDEO handles video steps. Add
# RUNPOD_ENDPOINT_ID_<KEY> for any further workflow_template key you register.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_ENDPOINT_ID_ILLUSTRATION=
# RUNPOD_ENDPOINT_ID_VIDEO=

# RunPod Network Volume S3 API — mirrors enabled weights so ComfyUI doesn't
# download them per generation. Settings -> S3 API Keys (separate from the key above).
# Docs: https://docs.runpod.io/storage/s3-api
# RUNPOD_VOLUME_ID=
# RUNPOD_DATACENTER=
# RUNPOD_S3_ACCESS_KEY_ID=
# RUNPOD_S3_SECRET_ACCESS_KEY=
